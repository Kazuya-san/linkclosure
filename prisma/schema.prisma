// prisma/schema.prisma
// LinkClosure MVP schema (Clerk + Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Plan {
  FREE
  PRO
}

enum LinkStatus {
  HEALTHY
  DELAYED
  AT_RISK
  CLOSED
  EXPIRED
}

enum GoalType {
  OPEN
}

enum EventType {
  CREATED
  OPENED
  REMINDER_SENT
  EXPIRED
}

model User {
  /// Clerk userId
  id        String   @id
  email     String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())

  lemonsqueezyCustomerId            String?   @db.VarChar(64)
  lemonsqueezySubscriptionId        String?   @unique @db.VarChar(64)
  lemonsqueezySubscriptionStatus    String?   @db.VarChar(32)
  lemonsqueezyRenewsAt              DateTime?
  lemonsqueezyEndsAt                DateTime?

  links     Link[]
}

model WebhookEvent {
  /// Provider event id (idempotency key)
  id         String   @id
  provider   String   @db.VarChar(32)
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
}

model Link {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalUrl     String     @db.Text
  slug            String     @unique

  goalType        GoalType   @default(OPEN)
  status          LinkStatus @default(HEALTHY)

  recipientEmail  String?    @db.VarChar(320)
  notifyOnOpen    Boolean    @default(true)

  remindAfterHours Int       @default(48)
  maxReminders     Int       @default(2)
  remindersSent    Int       @default(0)

  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?

  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  events          Event[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([slug])
}

model Event {
  id        String    @id @default(uuid())
  linkId    String
  link      Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)

  type      EventType
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([linkId, createdAt])
  @@index([type, createdAt])
}
